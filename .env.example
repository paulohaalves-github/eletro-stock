# Banco MySQL 8 (utf8mb4)
# Caracteres especiais da senha devem ser percent-encoded:
#   / → %2F   @ → %40   # → %23   % → %25   espaço → %20   ! → %21   * → %2A
# Docker local: mysql://eletro:eletrostock@localhost:3306/eletro_stock
# MySQL instalado no Windows: mysql://root:SENHA_ENCODED@localhost:3306/eletro_stock
DATABASE_URL="mysql://root:SUA_SENHA@localhost:3306/eletro_stock"

# Segredo JWT da sessão (gere um valor aleatório em produção)
AUTH_SECRET="altere-este-segredo-em-producao-eletro-stock"

# URL pública do sistema (use http://IP:3000 se acessar pela rede sem HTTPS)
APP_URL="http://localhost:3000"

# Cookie Secure: deixe false em HTTP na rede interna. true somente com HTTPS.
COOKIE_SECURE="false"

# IPs/hosts extras para acessar o next dev pela rede (além de localhost)
# ALLOWED_DEV_ORIGINS="10.8.6.11,ubuntu04"

# Upload
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB="8"
