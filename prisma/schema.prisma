generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(190)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         String   @db.VarChar(40)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  productsCreated Product[]      @relation("ProductCreatedBy")
  imagesUploaded  ProductImage[] @relation("ImageUploadedBy")
  filesUploaded   ProductFile[]  @relation("FileUploadedBy")
  movements       StockMovement[]
  auditLogs       AuditLog[]
  units           UserUnit[]
  customersCreated Customer[]         @relation("CustomerCreatedBy")
  salesCreated     Sale[]             @relation("SaleCreatedBy")
  workOrdersCreated WorkOrder[]       @relation("WorkOrderCreatedBy")
  workOrdersAsTechnician WorkOrder[]  @relation("WorkOrderTechnician")
  workOrderEvents  WorkOrderEvent[]
  workOrderImages  WorkOrderImage[]   @relation("WorkOrderImageUploadedBy")
  workOrderPartsRequested WorkOrderPart[] @relation("WorkOrderPartRequestedBy")
  workOrderPartsFulfilled WorkOrderPart[] @relation("WorkOrderPartFulfilledBy")
  partsCreated     Part[]             @relation("PartCreatedBy")
  partMovements    PartMovement[]
  partTransfersSent PartTransfer[]    @relation("PartTransferCreatedBy")
  partTransfersReceived PartTransfer[] @relation("PartTransferReceivedBy")

  @@map("users")
}

model Unit {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  slug      String   @unique @db.VarChar(80)
  type      String   @db.VarChar(40)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users            UserUnit[]
  products         Product[]        @relation("ProductUnit")
  incomingProducts Product[]        @relation("ProductTransferTo")
  locations        Location[]
  movementsFrom    StockMovement[]  @relation("MovementFromUnit")
  movementsTo      StockMovement[]  @relation("MovementToUnit")
  sales            Sale[]
  workOrders       WorkOrder[]      @relation("WorkOrderUnit")
  workOrdersLab    WorkOrder[]      @relation("WorkOrderLabUnit")
  partStocks       PartStock[]
  partMovements    PartMovement[]   @relation("PartMovementUnit")
  partMovementsTo  PartMovement[]   @relation("PartMovementToUnit")
  partTransfersFrom PartTransfer[]  @relation("PartTransferFromUnit")
  partTransfersTo   PartTransfer[]  @relation("PartTransferToUnit")

  @@map("units")
}

model UserUnit {
  userId Int @map("user_id")
  unitId Int @map("unit_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([userId, unitId])
  @@index([unitId])
  @@map("user_units")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Line {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("lines")
}

model CatalogModel {
  id                Int      @id @default(autoincrement())
  supplierModelCode String   @unique @map("supplier_model_code") @db.VarChar(120)
  commercialName    String   @map("commercial_name") @db.VarChar(190)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("catalog_models")
}

model LocationType {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  locations Location[]

  @@map("location_types")
}

model Location {
  id             Int      @id @default(autoincrement())
  unitId         Int      @map("unit_id")
  locationTypeId Int      @map("location_type_id")
  name           String   @db.VarChar(120)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  unit          Unit            @relation(fields: [unitId], references: [id])
  locationType  LocationType    @relation(fields: [locationTypeId], references: [id])
  products      Product[]
  movementsFrom StockMovement[] @relation("MovementFromLocation")
  movementsTo   StockMovement[] @relation("MovementToLocation")
  partStocks    PartStock[]
  partMovementsFrom PartMovement[] @relation("PartMovementFromLocation")
  partMovementsTo   PartMovement[] @relation("PartMovementToLocation")
  partTransfersFrom PartTransfer[] @relation("PartTransferFromLocation")
  partTransfersTo   PartTransfer[] @relation("PartTransferToLocation")

  @@unique([unitId, locationTypeId, name])
  @@index([locationTypeId])
  @@index([unitId])
  @@map("locations")
}

model Product {
  id                Int      @id @default(autoincrement())
  serialOnyx        String   @unique @map("serial_onyx") @db.VarChar(120)
  supplierModelCode String?  @map("supplier_model_code") @db.VarChar(120)
  catalogModelId    Int?     @map("catalog_model_id")
  ean               String?  @db.VarChar(32)
  lineId            Int?     @map("line_id")
  categoryId        Int      @map("category_id")
  capacitySizeType  String?  @map("capacity_size_type") @db.VarChar(120)
  condition         String   @db.VarChar(40)
  damageDescription String?  @map("damage_description") @db.Text
  description       String?  @db.Text
  installmentPrice  Float    @default(0) @map("installment_price")
  cashPrice         Float    @default(0) @map("cash_price")
  marketPrice       Float    @default(0) @map("market_price")
  status            String   @default("DISPONIVEL") @db.VarChar(40)
  origin            String?  @db.VarChar(255)
  entryDate         DateTime @default(now()) @map("entry_date")
  unitId            Int      @map("unit_id")
  transferToUnitId  Int?     @map("transfer_to_unit_id")
  locationId        Int?     @map("location_id")
  createdById       Int      @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  line           Line?         @relation(fields: [lineId], references: [id])
  category       Category      @relation(fields: [categoryId], references: [id])
  catalogModel   CatalogModel? @relation(fields: [catalogModelId], references: [id])
  createdBy      User          @relation("ProductCreatedBy", fields: [createdById], references: [id])
  unit           Unit          @relation("ProductUnit", fields: [unitId], references: [id])
  transferToUnit Unit?         @relation("ProductTransferTo", fields: [transferToUnitId], references: [id], onDelete: SetNull)
  location       Location?     @relation(fields: [locationId], references: [id])
  images         ProductImage[]
  files          ProductFile[]
  movements      StockMovement[]
  sales          Sale[]
  workOrders     WorkOrder[]

  @@index([ean])
  @@index([supplierModelCode])
  @@index([catalogModelId])
  @@index([status])
  @@index([condition])
  @@index([categoryId])
  @@index([lineId])
  @@index([entryDate])
  @@index([locationId])
  @@index([unitId])
  @@index([transferToUnitId])
  @@map("products")
}

model ProductImage {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  fileUrl      String   @map("file_url") @db.VarChar(500)
  fileName     String   @map("file_name") @db.VarChar(255)
  mimeType     String?  @map("mime_type") @db.VarChar(120)
  fileSize     Int?     @map("file_size")
  isPrimary    Boolean  @default(false) @map("is_primary")
  uploadedById Int      @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("ImageUploadedBy", fields: [uploadedById], references: [id])

  @@index([productId])
  @@map("product_images")
}

model ProductFile {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  fileUrl      String   @map("file_url") @db.VarChar(500)
  fileName     String   @map("file_name") @db.VarChar(255)
  mimeType     String?  @map("mime_type") @db.VarChar(120)
  fileSize     Int?     @map("file_size")
  uploadedById Int      @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("FileUploadedBy", fields: [uploadedById], references: [id])

  @@index([productId])
  @@map("product_files")
}

model StockMovement {
  id                 Int      @id @default(autoincrement())
  productId          Int      @map("product_id")
  type               String   @db.VarChar(40)
  reason             String?  @db.VarChar(40)
  previousStatus     String?  @map("previous_status") @db.VarChar(40)
  newStatus          String?  @map("new_status") @db.VarChar(40)
  observation        String?  @db.Text
  origin             String?  @db.VarChar(255)
  previousLocationId Int?     @map("previous_location_id")
  newLocationId      Int?     @map("new_location_id")
  previousUnitId     Int?     @map("previous_unit_id")
  newUnitId          Int?     @map("new_unit_id")
  userId             Int      @map("user_id")
  createdAt          DateTime @default(now()) @map("created_at")

  product          Product   @relation(fields: [productId], references: [id])
  user             User      @relation(fields: [userId], references: [id])
  previousLocation Location? @relation("MovementFromLocation", fields: [previousLocationId], references: [id], onDelete: SetNull)
  newLocation      Location? @relation("MovementToLocation", fields: [newLocationId], references: [id], onDelete: SetNull)
  previousUnit     Unit?     @relation("MovementFromUnit", fields: [previousUnitId], references: [id], onDelete: SetNull)
  newUnit          Unit?     @relation("MovementToUnit", fields: [newUnitId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([createdAt])
  @@index([type])
  @@index([userId])
  @@index([previousUnitId])
  @@index([newUnitId])
  @@map("stock_movements")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  action    String   @db.VarChar(80)
  entity    String   @db.VarChar(80)
  entityId  Int      @map("entity_id")
  oldData   String?  @map("old_data") @db.LongText
  newData   String?  @map("new_data") @db.LongText
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model Customer {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(190)
  phone       String   @db.VarChar(40)
  document    String?  @db.VarChar(20)
  email       String?  @db.VarChar(190)
  address     String?  @db.VarChar(255)
  notes       String?  @db.Text
  createdById Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy  User        @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  sales      Sale[]
  workOrders WorkOrder[]

  @@index([name])
  @@index([phone])
  @@index([document])
  @@map("customers")
}

model Sale {
  id             Int      @id @default(autoincrement())
  productId      Int      @map("product_id")
  customerId     Int      @map("customer_id")
  unitId         Int      @map("unit_id")
  soldAt         DateTime @map("sold_at")
  warrantyMonths Int      @map("warranty_months")
  invoiceNumber  String?  @map("invoice_number") @db.VarChar(40)
  observation    String?  @db.Text
  createdById    Int      @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id])
  customer   Customer    @relation(fields: [customerId], references: [id])
  unit       Unit        @relation(fields: [unitId], references: [id])
  createdBy  User        @relation("SaleCreatedBy", fields: [createdById], references: [id])
  workOrders WorkOrder[]

  @@index([productId])
  @@index([customerId])
  @@index([unitId])
  @@index([soldAt])
  @@map("sales")
}

model WorkOrder {
  id              Int       @id @default(autoincrement())
  number          String    @unique @db.VarChar(40)
  productId       Int       @map("product_id")
  saleId          Int       @map("sale_id")
  customerId      Int       @map("customer_id")
  unitId          Int       @map("unit_id")
  labUnitId       Int?      @map("lab_unit_id")
  servicePlace    String    @map("service_place") @db.VarChar(40)
  status          String    @db.VarChar(40)
  reportedDefect  String    @map("reported_defect") @db.Text
  analysisNotes   String?   @map("analysis_notes") @db.Text
  technicianNotes String?   @map("technician_notes") @db.Text
  createdById     Int       @map("created_by")
  technicianId    Int?      @map("technician_id")
  openedAt        DateTime  @default(now()) @map("opened_at")
  closedAt        DateTime? @map("closed_at")
  deliveredAt     DateTime? @map("delivered_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  product    Product          @relation(fields: [productId], references: [id])
  sale       Sale             @relation(fields: [saleId], references: [id])
  customer   Customer         @relation(fields: [customerId], references: [id])
  unit       Unit             @relation("WorkOrderUnit", fields: [unitId], references: [id])
  labUnit    Unit?            @relation("WorkOrderLabUnit", fields: [labUnitId], references: [id])
  createdBy  User             @relation("WorkOrderCreatedBy", fields: [createdById], references: [id])
  technician User?            @relation("WorkOrderTechnician", fields: [technicianId], references: [id])
  events     WorkOrderEvent[]
  images     WorkOrderImage[]
  parts      WorkOrderPart[]
  partMovements PartMovement[]

  @@index([productId])
  @@index([saleId])
  @@index([customerId])
  @@index([unitId])
  @@index([labUnitId])
  @@index([status])
  @@index([servicePlace])
  @@index([openedAt])
  @@map("work_orders")
}

model WorkOrderEvent {
  id          Int      @id @default(autoincrement())
  workOrderId Int      @map("work_order_id")
  type        String   @db.VarChar(40)
  message     String   @db.Text
  userId      Int      @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([workOrderId])
  @@index([createdAt])
  @@map("work_order_events")
}

model WorkOrderImage {
  id           Int      @id @default(autoincrement())
  workOrderId  Int      @map("work_order_id")
  fileUrl      String   @map("file_url") @db.VarChar(500)
  fileName     String   @map("file_name") @db.VarChar(255)
  mimeType     String?  @map("mime_type") @db.VarChar(120)
  fileSize     Int?     @map("file_size")
  uploadedById Int      @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  workOrder  WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation("WorkOrderImageUploadedBy", fields: [uploadedById], references: [id])

  @@index([workOrderId])
  @@map("work_order_images")
}

model WorkOrderPart {
  id              Int       @id @default(autoincrement())
  workOrderId     Int       @map("work_order_id")
  partId          Int       @map("part_id")
  quantity        Int
  status          String    @db.VarChar(40)
  unitId          Int?      @map("unit_id")
  locationId      Int?      @map("location_id")
  observation     String?   @db.Text
  requestedById   Int       @map("requested_by")
  fulfilledById   Int?      @map("fulfilled_by")
  fulfilledAt     DateTime? @map("fulfilled_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  part        Part      @relation(fields: [partId], references: [id])
  requestedBy User      @relation("WorkOrderPartRequestedBy", fields: [requestedById], references: [id])
  fulfilledBy User?     @relation("WorkOrderPartFulfilledBy", fields: [fulfilledById], references: [id])

  @@index([workOrderId])
  @@index([partId])
  @@index([status])
  @@map("work_order_parts")
}

model Part {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(190)
  description String?  @db.Text
  active      Boolean  @default(true)
  createdById Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy  User             @relation("PartCreatedBy", fields: [createdById], references: [id])
  stocks     PartStock[]
  movements  PartMovement[]
  transfers  PartTransfer[]
  workOrderParts WorkOrderPart[]

  @@index([name])
  @@index([active])
  @@map("parts")
}

model PartStock {
  id         Int      @id @default(autoincrement())
  partId     Int      @map("part_id")
  unitId     Int      @map("unit_id")
  locationId Int      @map("location_id")
  quantity   Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at")

  part     Part     @relation(fields: [partId], references: [id])
  unit     Unit     @relation(fields: [unitId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([partId, unitId, locationId])
  @@index([unitId])
  @@index([locationId])
  @@map("part_stocks")
}

model PartMovement {
  id                 Int      @id @default(autoincrement())
  partId             Int      @map("part_id")
  type               String   @db.VarChar(40)
  quantity           Int
  previousQuantity   Int?     @map("previous_quantity")
  newQuantity        Int?     @map("new_quantity")
  unitId             Int      @map("unit_id")
  locationId         Int?     @map("location_id")
  toUnitId           Int?     @map("to_unit_id")
  toLocationId       Int?     @map("to_location_id")
  workOrderId        Int?     @map("work_order_id")
  observation        String?  @db.Text
  userId             Int      @map("user_id")
  createdAt          DateTime @default(now()) @map("created_at")

  part       Part       @relation(fields: [partId], references: [id])
  unit       Unit       @relation("PartMovementUnit", fields: [unitId], references: [id])
  toUnit     Unit?      @relation("PartMovementToUnit", fields: [toUnitId], references: [id])
  location   Location?  @relation("PartMovementFromLocation", fields: [locationId], references: [id], onDelete: SetNull)
  toLocation Location?  @relation("PartMovementToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  workOrder  WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  user       User       @relation(fields: [userId], references: [id])

  @@index([partId])
  @@index([unitId])
  @@index([createdAt])
  @@index([type])
  @@index([workOrderId])
  @@map("part_movements")
}

model PartTransfer {
  id             Int      @id @default(autoincrement())
  partId         Int      @map("part_id")
  quantity       Int
  fromUnitId     Int      @map("from_unit_id")
  fromLocationId Int      @map("from_location_id")
  toUnitId       Int      @map("to_unit_id")
  toLocationId   Int?     @map("to_location_id")
  status         String   @db.VarChar(40)
  observation    String?  @db.Text
  createdById    Int      @map("created_by")
  receivedById   Int?     @map("received_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  part         Part      @relation(fields: [partId], references: [id])
  fromUnit     Unit      @relation("PartTransferFromUnit", fields: [fromUnitId], references: [id])
  toUnit       Unit      @relation("PartTransferToUnit", fields: [toUnitId], references: [id])
  fromLocation Location  @relation("PartTransferFromLocation", fields: [fromLocationId], references: [id])
  toLocation   Location? @relation("PartTransferToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  createdBy    User      @relation("PartTransferCreatedBy", fields: [createdById], references: [id])
  receivedBy   User?     @relation("PartTransferReceivedBy", fields: [receivedById], references: [id])

  @@index([partId])
  @@index([fromUnitId])
  @@index([toUnitId])
  @@index([status])
  @@map("part_transfers")
}
