generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(190)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         String   @db.VarChar(40)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  productsCreated Product[]      @relation("ProductCreatedBy")
  productsDeleted Product[]      @relation("ProductDeletedBy")
  imagesUploaded  ProductImage[] @relation("ImageUploadedBy")
  filesUploaded   ProductFile[]  @relation("FileUploadedBy")
  movements       StockMovement[]
  auditLogs       AuditLog[]
  units           UserUnit[]
  customersCreated Customer[]         @relation("CustomerCreatedBy")
  salesCreated     Sale[]             @relation("SaleCreatedBy")
  workOrdersCreated WorkOrder[]       @relation("WorkOrderCreatedBy")
  workOrdersAsTechnician WorkOrder[]  @relation("WorkOrderTechnician")
  workOrderEvents  WorkOrderEvent[]
  workOrderImages  WorkOrderImage[]   @relation("WorkOrderImageUploadedBy")
  workOrderPartsRequested WorkOrderPart[] @relation("WorkOrderPartRequestedBy")
  workOrderPartsFulfilled WorkOrderPart[] @relation("WorkOrderPartFulfilledBy")
  partsCreated     Part[]             @relation("PartCreatedBy")
  partMovements    PartMovement[]
  partTransfersSent PartTransfer[]    @relation("PartTransferCreatedBy")
  partTransfersReceived PartTransfer[] @relation("PartTransferReceivedBy")
  inboxTeamMemberships InboxTeamMember[]
  inboxConversationsAsAgent InboxConversation[] @relation("ConversationAgent")
  inboxConversationsAccepted InboxConversation[] @relation("ConversationAcceptedBy")
  inboxConversationsClosed InboxConversation[] @relation("ConversationClosedBy")
  inboxMessages InboxMessage[]
  inboxConversationEvents InboxConversationEvent[]
  saleOrdersCreated SaleOrder[]       @relation("SaleOrderCreatedBy")
  saleOrdersAsSeller SaleOrder[]      @relation("SaleOrderSeller")
  saleOrderEvents   SaleOrderEvent[]
  saleOrderItemsSold SaleOrderItem[]  @relation("SaleOrderItemSoldBy")

  @@map("users")
}

model Unit {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  slug      String   @unique @db.VarChar(80)
  type      String   @db.VarChar(40)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users            UserUnit[]
  products         Product[]        @relation("ProductUnit")
  incomingProducts Product[]        @relation("ProductTransferTo")
  locations        Location[]
  movementsFrom    StockMovement[]  @relation("MovementFromUnit")
  movementsTo      StockMovement[]  @relation("MovementToUnit")
  sales            Sale[]
  saleOrders       SaleOrder[]
  workOrders       WorkOrder[]      @relation("WorkOrderUnit")
  workOrdersLab    WorkOrder[]      @relation("WorkOrderLabUnit")
  partStocks       PartStock[]
  partMovements    PartMovement[]   @relation("PartMovementUnit")
  partMovementsTo  PartMovement[]   @relation("PartMovementToUnit")
  partTransfersFrom PartTransfer[]  @relation("PartTransferFromUnit")
  partTransfersTo   PartTransfer[]  @relation("PartTransferToUnit")

  @@map("units")
}

model UserUnit {
  userId Int @map("user_id")
  unitId Int @map("unit_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([userId, unitId])
  @@index([unitId])
  @@map("user_units")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Line {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("lines")
}

model CatalogModel {
  id                Int      @id @default(autoincrement())
  supplierModelCode String   @unique @map("supplier_model_code") @db.VarChar(120)
  commercialName    String   @map("commercial_name") @db.VarChar(190)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("catalog_models")
}

model LocationType {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  locations Location[]

  @@map("location_types")
}

model Location {
  id             Int      @id @default(autoincrement())
  unitId         Int      @map("unit_id")
  locationTypeId Int      @map("location_type_id")
  name           String   @db.VarChar(120)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  unit          Unit            @relation(fields: [unitId], references: [id])
  locationType  LocationType    @relation(fields: [locationTypeId], references: [id])
  products      Product[]
  movementsFrom StockMovement[] @relation("MovementFromLocation")
  movementsTo   StockMovement[] @relation("MovementToLocation")
  partStocks    PartStock[]
  partMovementsFrom PartMovement[] @relation("PartMovementFromLocation")
  partMovementsTo   PartMovement[] @relation("PartMovementToLocation")
  partTransfersFrom PartTransfer[] @relation("PartTransferFromLocation")
  partTransfersTo   PartTransfer[] @relation("PartTransferToLocation")

  @@unique([unitId, locationTypeId, name])
  @@index([locationTypeId])
  @@index([unitId])
  @@map("locations")
}

model Product {
  id                Int      @id @default(autoincrement())
  serialOnyx        String   @unique @map("serial_onyx") @db.VarChar(120)
  supplierModelCode String?  @map("supplier_model_code") @db.VarChar(120)
  catalogModelId    Int?     @map("catalog_model_id")
  ean               String?  @db.VarChar(32)
  lineId            Int?     @map("line_id")
  categoryId        Int      @map("category_id")
  capacitySizeType  String?  @map("capacity_size_type") @db.VarChar(120)
  voltage           String?  @db.VarChar(20)
  condition         String   @db.VarChar(40)
  damageDescription String?  @map("damage_description") @db.Text
  description       String?  @db.Text
  installmentPrice  Float    @default(0) @map("installment_price")
  cashPrice         Float    @default(0) @map("cash_price")
  marketPrice       Float    @default(0) @map("market_price")
  lastPriceUpdateAt DateTime @default(now()) @map("last_price_update_at")
  status            String   @default("DISPONIVEL") @db.VarChar(40)
  origin            String?  @db.VarChar(255)
  entryDate         DateTime @default(now()) @map("entry_date")
  unitId            Int      @map("unit_id")
  transferToUnitId  Int?     @map("transfer_to_unit_id")
  locationId        Int?     @map("location_id")
  createdById       Int      @map("created_by")
  deletedAt         DateTime? @map("deleted_at")
  deletedById       Int?     @map("deleted_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  line           Line?         @relation(fields: [lineId], references: [id])
  category       Category      @relation(fields: [categoryId], references: [id])
  catalogModel   CatalogModel? @relation(fields: [catalogModelId], references: [id])
  createdBy      User          @relation("ProductCreatedBy", fields: [createdById], references: [id])
  deletedBy      User?         @relation("ProductDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  unit           Unit          @relation("ProductUnit", fields: [unitId], references: [id])
  transferToUnit Unit?         @relation("ProductTransferTo", fields: [transferToUnitId], references: [id], onDelete: SetNull)
  location       Location?     @relation(fields: [locationId], references: [id])
  images         ProductImage[]
  files          ProductFile[]
  movements      StockMovement[]
  sales          Sale[]
  saleOrderItems SaleOrderItem[]
  workOrders     WorkOrder[]

  @@index([ean])
  @@index([supplierModelCode])
  @@index([catalogModelId])
  @@index([status])
  @@index([condition])
  @@index([voltage])
  @@index([categoryId])
  @@index([lineId])
  @@index([entryDate])
  @@index([lastPriceUpdateAt])
  @@index([locationId])
  @@index([unitId])
  @@index([transferToUnitId])
  @@index([deletedAt])
  @@index([deletedById])
  @@map("products")
}

model ProductImage {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  fileUrl      String   @map("file_url") @db.VarChar(500)
  fileName     String   @map("file_name") @db.VarChar(255)
  mimeType     String?  @map("mime_type") @db.VarChar(120)
  fileSize     Int?     @map("file_size")
  isPrimary    Boolean  @default(false) @map("is_primary")
  uploadedById Int      @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("ImageUploadedBy", fields: [uploadedById], references: [id])

  @@index([productId])
  @@map("product_images")
}

model ProductFile {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  fileUrl      String   @map("file_url") @db.VarChar(500)
  fileName     String   @map("file_name") @db.VarChar(255)
  mimeType     String?  @map("mime_type") @db.VarChar(120)
  fileSize     Int?     @map("file_size")
  uploadedById Int      @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("FileUploadedBy", fields: [uploadedById], references: [id])

  @@index([productId])
  @@map("product_files")
}

model StockMovement {
  id                 Int      @id @default(autoincrement())
  productId          Int      @map("product_id")
  type               String   @db.VarChar(40)
  reason             String?  @db.VarChar(40)
  previousStatus     String?  @map("previous_status") @db.VarChar(40)
  newStatus          String?  @map("new_status") @db.VarChar(40)
  observation        String?  @db.Text
  origin             String?  @db.VarChar(255)
  previousLocationId Int?     @map("previous_location_id")
  newLocationId      Int?     @map("new_location_id")
  previousUnitId     Int?     @map("previous_unit_id")
  newUnitId          Int?     @map("new_unit_id")
  userId             Int      @map("user_id")
  createdAt          DateTime @default(now()) @map("created_at")

  product          Product   @relation(fields: [productId], references: [id])
  user             User      @relation(fields: [userId], references: [id])
  previousLocation Location? @relation("MovementFromLocation", fields: [previousLocationId], references: [id], onDelete: SetNull)
  newLocation      Location? @relation("MovementToLocation", fields: [newLocationId], references: [id], onDelete: SetNull)
  previousUnit     Unit?     @relation("MovementFromUnit", fields: [previousUnitId], references: [id], onDelete: SetNull)
  newUnit          Unit?     @relation("MovementToUnit", fields: [newUnitId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([createdAt])
  @@index([type])
  @@index([userId])
  @@index([previousUnitId])
  @@index([newUnitId])
  @@map("stock_movements")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  action    String   @db.VarChar(80)
  entity    String   @db.VarChar(80)
  entityId  Int      @map("entity_id")
  oldData   String?  @map("old_data") @db.LongText
  newData   String?  @map("new_data") @db.LongText
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model Customer {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(190)
  phone       String   @db.VarChar(40)
  document    String?  @db.VarChar(20)
  email       String?  @db.VarChar(190)
  address     String?  @db.VarChar(255)
  notes       String?  @db.Text
  createdById Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy     User                @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  phones        CustomerPhone[]
  sales         Sale[]
  saleOrders    SaleOrder[]
  workOrders    WorkOrder[]
  conversations InboxConversation[]

  @@index([name])
  @@index([phone])
  @@index([document])
  @@map("customers")
}

model CustomerPhone {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  phone      String   @db.VarChar(40)
  digits     String   @db.VarChar(20)
  label      String?  @db.VarChar(40)
  primary    Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, digits])
  @@index([digits])
  @@index([customerId])
  @@map("customer_phones")
}

model Sale {
  id             Int      @id @default(autoincrement())
  productId      Int      @map("product_id")
  customerId     Int      @map("customer_id")
  unitId         Int      @map("unit_id")
  soldAt         DateTime @map("sold_at")
  warrantyMonths Int      @map("warranty_months")
  invoiceNumber  String?  @map("invoice_number") @db.VarChar(40)
  observation    String?  @db.Text
  cashPrice      Float    @default(0) @map("cash_price")
  createdById    Int      @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product        Product         @relation(fields: [productId], references: [id])
  customer       Customer        @relation(fields: [customerId], references: [id])
  unit           Unit            @relation(fields: [unitId], references: [id])
  createdBy      User            @relation("SaleCreatedBy", fields: [createdById], references: [id])
  workOrders     WorkOrder[]
  saleOrderItems SaleOrderItem[]

  @@index([productId])
  @@index([customerId])
  @@index([unitId])
  @@index([soldAt])
  @@map("sales")
}

model SaleOrder {
  id           Int       @id @default(autoincrement())
  number       String    @unique @db.VarChar(40)
  customerId   Int       @map("customer_id")
  unitId       Int       @map("unit_id")
  sellerId       Int       @map("seller_id")
  conversationId Int?      @map("conversation_id")
  status         String    @db.VarChar(40)
  observation    String?   @db.Text
  createdById    Int       @map("created_by")
  orderedAt    DateTime? @map("ordered_at")
  closedAt     DateTime? @map("closed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  customer     Customer            @relation(fields: [customerId], references: [id])
  unit         Unit                @relation(fields: [unitId], references: [id])
  seller       User                @relation("SaleOrderSeller", fields: [sellerId], references: [id])
  createdBy    User                @relation("SaleOrderCreatedBy", fields: [createdById], references: [id])
  conversation InboxConversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  items        SaleOrderItem[]
  events       SaleOrderEvent[]

  @@index([customerId])
  @@index([unitId])
  @@index([sellerId])
  @@index([conversationId])
  @@index([status])
  @@index([createdAt])
  @@map("sale_orders")
}

model SaleOrderItem {
  id             Int       @id @default(autoincrement())
  saleOrderId    Int       @map("sale_order_id")
  productId      Int       @map("product_id")
  status         String    @db.VarChar(40)
  cashPrice      Float?    @map("cash_price")
  saleId         Int?      @map("sale_id")
  warrantyMonths Int?      @map("warranty_months")
  invoiceNumber  String?   @map("invoice_number") @db.VarChar(40)
  reservedAt     DateTime? @map("reserved_at")
  reservedUntil  DateTime? @map("reserved_until")
  soldAt         DateTime? @map("sold_at")
  soldById       Int?      @map("sold_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  saleOrder SaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
  sale      Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  soldBy    User?     @relation("SaleOrderItemSoldBy", fields: [soldById], references: [id], onDelete: SetNull)

  @@unique([saleOrderId, productId])
  @@index([productId])
  @@index([status])
  @@index([saleId])
  @@index([reservedUntil])
  @@map("sale_order_items")
}

model SaleOrderEvent {
  id          Int      @id @default(autoincrement())
  saleOrderId Int      @map("sale_order_id")
  type        String   @db.VarChar(40)
  message     String   @db.Text
  userId      Int      @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  saleOrder SaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([saleOrderId])
  @@index([createdAt])
  @@map("sale_order_events")
}

model WorkOrder {
  id              Int       @id @default(autoincrement())
  number          String    @unique @db.VarChar(40)
  productId       Int       @map("product_id")
  saleId          Int?      @map("sale_id")
  customerId      Int?      @map("customer_id")
  unitId          Int       @map("unit_id")
  labUnitId       Int?      @map("lab_unit_id")
  type            String    @default("POS_VENDA") @db.VarChar(40)
  servicePlace    String    @map("service_place") @db.VarChar(40)
  status          String    @db.VarChar(40)
  reportedDefect  String    @map("reported_defect") @db.Text
  analysisNotes   String?   @map("analysis_notes") @db.Text
  technicianNotes String?   @map("technician_notes") @db.Text
  createdById     Int       @map("created_by")
  technicianId    Int?      @map("technician_id")
  openedAt        DateTime  @default(now()) @map("opened_at")
  closedAt        DateTime? @map("closed_at")
  deliveredAt     DateTime? @map("delivered_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  product    Product          @relation(fields: [productId], references: [id])
  sale       Sale?            @relation(fields: [saleId], references: [id])
  customer   Customer?        @relation(fields: [customerId], references: [id])
  unit       Unit             @relation("WorkOrderUnit", fields: [unitId], references: [id])
  labUnit    Unit?            @relation("WorkOrderLabUnit", fields: [labUnitId], references: [id])
  createdBy  User             @relation("WorkOrderCreatedBy", fields: [createdById], references: [id])
  technician User?            @relation("WorkOrderTechnician", fields: [technicianId], references: [id])
  events     WorkOrderEvent[]
  images     WorkOrderImage[]
  parts      WorkOrderPart[]
  partMovements PartMovement[]

  @@index([productId])
  @@index([saleId])
  @@index([customerId])
  @@index([unitId])
  @@index([labUnitId])
  @@index([status])
  @@index([type])
  @@index([servicePlace])
  @@index([openedAt])
  @@map("work_orders")
}

model WorkOrderEvent {
  id          Int      @id @default(autoincrement())
  workOrderId Int      @map("work_order_id")
  type        String   @db.VarChar(40)
  message     String   @db.Text
  userId      Int      @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([workOrderId])
  @@index([createdAt])
  @@map("work_order_events")
}

model WorkOrderImage {
  id           Int      @id @default(autoincrement())
  workOrderId  Int      @map("work_order_id")
  fileUrl      String   @map("file_url") @db.VarChar(500)
  fileName     String   @map("file_name") @db.VarChar(255)
  mimeType     String?  @map("mime_type") @db.VarChar(120)
  fileSize     Int?     @map("file_size")
  uploadedById Int      @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  workOrder  WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation("WorkOrderImageUploadedBy", fields: [uploadedById], references: [id])

  @@index([workOrderId])
  @@map("work_order_images")
}

model WorkOrderPart {
  id              Int       @id @default(autoincrement())
  workOrderId     Int       @map("work_order_id")
  partId          Int       @map("part_id")
  quantity        Int
  status          String    @db.VarChar(40)
  unitId          Int?      @map("unit_id")
  locationId      Int?      @map("location_id")
  observation     String?   @db.Text
  requestedById   Int       @map("requested_by")
  fulfilledById   Int?      @map("fulfilled_by")
  fulfilledAt     DateTime? @map("fulfilled_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  part        Part      @relation(fields: [partId], references: [id])
  requestedBy User      @relation("WorkOrderPartRequestedBy", fields: [requestedById], references: [id])
  fulfilledBy User?     @relation("WorkOrderPartFulfilledBy", fields: [fulfilledById], references: [id])

  @@index([workOrderId])
  @@index([partId])
  @@index([status])
  @@map("work_order_parts")
}

model Part {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(190)
  description String?  @db.Text
  active      Boolean  @default(true)
  createdById Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy  User             @relation("PartCreatedBy", fields: [createdById], references: [id])
  stocks     PartStock[]
  movements  PartMovement[]
  transfers  PartTransfer[]
  workOrderParts WorkOrderPart[]

  @@index([name])
  @@index([active])
  @@map("parts")
}

model PartStock {
  id         Int      @id @default(autoincrement())
  partId     Int      @map("part_id")
  unitId     Int      @map("unit_id")
  locationId Int      @map("location_id")
  quantity   Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at")

  part     Part     @relation(fields: [partId], references: [id])
  unit     Unit     @relation(fields: [unitId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([partId, unitId, locationId])
  @@index([unitId])
  @@index([locationId])
  @@map("part_stocks")
}

model PartMovement {
  id                 Int      @id @default(autoincrement())
  partId             Int      @map("part_id")
  type               String   @db.VarChar(40)
  quantity           Int
  previousQuantity   Int?     @map("previous_quantity")
  newQuantity        Int?     @map("new_quantity")
  unitId             Int      @map("unit_id")
  locationId         Int?     @map("location_id")
  toUnitId           Int?     @map("to_unit_id")
  toLocationId       Int?     @map("to_location_id")
  workOrderId        Int?     @map("work_order_id")
  observation        String?  @db.Text
  userId             Int      @map("user_id")
  createdAt          DateTime @default(now()) @map("created_at")

  part       Part       @relation(fields: [partId], references: [id])
  unit       Unit       @relation("PartMovementUnit", fields: [unitId], references: [id])
  toUnit     Unit?      @relation("PartMovementToUnit", fields: [toUnitId], references: [id])
  location   Location?  @relation("PartMovementFromLocation", fields: [locationId], references: [id], onDelete: SetNull)
  toLocation Location?  @relation("PartMovementToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  workOrder  WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  user       User       @relation(fields: [userId], references: [id])

  @@index([partId])
  @@index([unitId])
  @@index([createdAt])
  @@index([type])
  @@index([workOrderId])
  @@map("part_movements")
}

model PartTransfer {
  id             Int      @id @default(autoincrement())
  partId         Int      @map("part_id")
  quantity       Int
  fromUnitId     Int      @map("from_unit_id")
  fromLocationId Int      @map("from_location_id")
  toUnitId       Int      @map("to_unit_id")
  toLocationId   Int?     @map("to_location_id")
  status         String   @db.VarChar(40)
  observation    String?  @db.Text
  createdById    Int      @map("created_by")
  receivedById   Int?     @map("received_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  part         Part      @relation(fields: [partId], references: [id])
  fromUnit     Unit      @relation("PartTransferFromUnit", fields: [fromUnitId], references: [id])
  toUnit       Unit      @relation("PartTransferToUnit", fields: [toUnitId], references: [id])
  fromLocation Location  @relation("PartTransferFromLocation", fields: [fromLocationId], references: [id])
  toLocation   Location? @relation("PartTransferToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  createdBy    User      @relation("PartTransferCreatedBy", fields: [createdById], references: [id])
  receivedBy   User?     @relation("PartTransferReceivedBy", fields: [receivedById], references: [id])

  @@index([partId])
  @@index([fromUnitId])
  @@index([toUnitId])
  @@index([status])
  @@map("part_transfers")
}

model InboxTeam {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  slug      String   @unique @db.VarChar(80)
  color     String   @default("#22d3ee") @db.VarChar(20)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members       InboxTeamMember[]
  channels      InboxChannel[]
  conversations InboxConversation[]

  @@map("inbox_teams")
}

model InboxTeamMember {
  teamId            Int    @map("team_id")
  userId            Int    @map("user_id")
  role              String @default("AGENT") @db.VarChar(40)
  conversationLimit Int    @default(0) @map("conversation_limit")

  team InboxTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("inbox_team_members")
}

model InboxChannel {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(120)
  type             String   @default("WHATSAPP") @db.VarChar(40)
  provider         String   @db.VarChar(40)
  phoneNumber      String?  @map("phone_number") @db.VarChar(40)
  externalId       String?  @map("external_id") @db.VarChar(120)
  apiKey           String?  @map("api_key") @db.Text
  webhookSecret    String?  @map("webhook_secret") @db.VarChar(255)
  connectionStatus String   @default("DISCONNECTED") @map("connection_status") @db.VarChar(40)
  connectionError  String?  @map("connection_error") @db.Text
  qrPayload        String?  @map("qr_payload") @db.LongText
  defaultTeamId    Int      @map("default_team_id")
  active           Boolean  @default(true)
  businessHoursEnabled     Boolean  @default(false) @map("business_hours_enabled")
  timezone                 String   @default("America/Sao_Paulo") @db.VarChar(60)
  businessHours            Json?    @map("business_hours")
  afterHoursReplyEnabled   Boolean  @default(false) @map("after_hours_reply_enabled")
  afterHoursMessage        String?  @map("after_hours_message") @db.Text
  greetingEnabled          Boolean  @default(false) @map("greeting_enabled")
  greetingMode             String   @default("FIRST_CONTACT") @map("greeting_mode") @db.VarChar(40)
  greetingMessage          String?  @map("greeting_message") @db.Text
  unansweredEnabled        Boolean  @default(false) @map("unanswered_enabled")
  unansweredMinutes        Int      @default(5) @map("unanswered_minutes")
  unansweredMessage        String?  @map("unanswered_message") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  defaultTeam   InboxTeam           @relation(fields: [defaultTeamId], references: [id])
  conversations InboxConversation[]

  @@index([provider])
  @@index([defaultTeamId])
  @@index([phoneNumber])
  @@map("inbox_channels")
}

model InboxConversation {
  id                    Int       @id @default(autoincrement())
  channelId             Int       @map("channel_id")
  teamId                Int       @map("team_id")
  customerId            Int?      @map("customer_id")
  agentId               Int?      @map("agent_id")
  acceptedById          Int?      @map("accepted_by")
  closedById            Int?      @map("closed_by")
  phone                 String    @db.VarChar(40)
  whatsappJid           String?   @map("whatsapp_jid") @db.VarChar(120)
  contactName           String?   @map("contact_name") @db.VarChar(190)
  status                String    @db.VarChar(40)
  lastMessagePreview    String?   @map("last_message_preview") @db.VarChar(255)
  lastMessageDirection  String?   @map("last_message_direction") @db.VarChar(20)
  lastMessageAt         DateTime? @map("last_message_at")
  lastCustomerMessageAt DateTime? @map("last_customer_message_at")
  lastAgentMessageAt    DateTime? @map("last_agent_message_at")
  queuedAt              DateTime  @default(now()) @map("queued_at")
  acceptedAt            DateTime? @map("accepted_at")
  firstResponseAt       DateTime? @map("first_response_at")
  closedAt              DateTime? @map("closed_at")
  reopenedAt            DateTime? @map("reopened_at")
  waitingSince          DateTime? @map("waiting_since")
  unreadCount           Int       @default(0) @map("unread_count")
  greetingSentAt        DateTime? @map("greeting_sent_at")
  afterHoursSentAt      DateTime? @map("after_hours_sent_at")
  unansweredNotifiedAt  DateTime? @map("unanswered_notified_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  channel    InboxChannel             @relation(fields: [channelId], references: [id])
  team       InboxTeam                @relation(fields: [teamId], references: [id])
  customer   Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  agent      User?                    @relation("ConversationAgent", fields: [agentId], references: [id], onDelete: SetNull)
  acceptedBy User?                    @relation("ConversationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  closedBy   User?                    @relation("ConversationClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  messages   InboxMessage[]
  events     InboxConversationEvent[]
  saleOrders SaleOrder[]

  @@unique([channelId, phone])
  @@index([teamId])
  @@index([customerId])
  @@index([agentId])
  @@index([status])
  @@index([lastMessageAt])
  @@index([whatsappJid])
  @@map("inbox_conversations")
}

model InboxMessage {
  id             Int       @id @default(autoincrement())
  conversationId Int       @map("conversation_id")
  userId         Int?      @map("user_id")
  direction      String    @db.VarChar(20)
  body           String?   @db.Text
  mediaUrl       String?   @map("media_url") @db.VarChar(500)
  mediaType      String?   @map("media_type") @db.VarChar(80)
  fileName       String?   @map("file_name") @db.VarChar(255)
  externalId     String?   @unique @map("external_id") @db.VarChar(190)
  status         String    @default("SENT") @db.VarChar(40)
  sentAt         DateTime  @default(now()) @map("sent_at")
  deliveredAt    DateTime? @map("delivered_at")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([sentAt])
  @@map("inbox_messages")
}

model AppSetting {
  key       String   @id @db.VarChar(80)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model InboxConversationEvent {
  id             Int      @id @default(autoincrement())
  conversationId Int      @map("conversation_id")
  type           String   @db.VarChar(40)
  message        String   @db.Text
  userId         Int?     @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([createdAt])
  @@map("inbox_conversation_events")
}
